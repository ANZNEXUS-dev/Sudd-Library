---
import BaseLayout from '../layouts/BaseLayout.astro';
import LevelCard from '../components/LevelCard.astro';
import { CURRICULUM, RESOURCE_TYPE_LABELS, getSubject } from '../data/curriculum';
import { SITE } from '../data/site';
import { getCollection } from 'astro:content';

const allResources = await getCollection('resources');
const recent = [...allResources]
  .sort((a, b) => b.data.dateAdded.valueOf() - a.data.dateAdded.valueOf())
  .slice(0, 6);

const total = allResources.length;
const iconFor = { primary: 'primary', secondary: 'secondary', aes: 'aes' } as const;
---
<BaseLayout title={SITE.name} description={SITE.tagline}>
  <section class="hero">
    <div class="hero-inner">
      <h1>The free <span>South Sudan</span> curriculum library</h1>
      <p class="hero-sub">
        Lesson notes, schemes of work and past papers for Primary, Secondary and AES.
      </p>
        <form class="search-form" action="/search/" method="get" role="search">
        <label for="home-q" class="sr-only">Search resources</label>
        <input
          id="home-q"
          name="q"
          type="search"
          placeholder="Try: P6 Science, S3 Biology"
          autocomplete="off"
        />
        <button type="submit">Search</button>
      </form>


      <div class="reassure">
        <span><span class="dot"></span>Works offline</span>
        <span><span class="dot"></span>No login</span>
        <span><span class="dot"></span>Free to access</span>
      </div>

      {total > 0 && (
        <p class="hero-count"><strong>{total}</strong> resources and growing</p>
      )}
      <p class="hero-note">Independent project, aligned to the NCDC curriculum.</p>
    </div>
  </section>

  <section class="wrap">
    <p class="section-title">Choose a level</p>
    <div class="level-grid">
      {CURRICULUM.map((level) => (
        <LevelCard
          name={level.name}
          description={level.description}
          href={`/${level.slug}/`}
          icon={iconFor[level.slug]}
        />
      ))}
    </div>
  </section>

  <section class="wrap">
    <p class="section-title">Recently added</p>
    {recent.length > 0 ? (
      <div class="recent-list">
        {recent.map((r) => {
          const subject = getSubject(r.data.level, r.data.classSlug, r.data.subjectSlug);
          const subline = [subject?.name, RESOURCE_TYPE_LABELS[r.data.type]].filter(Boolean).join(' · ');
          return (
            <a class="recent-row" href={`/${r.data.level}/${r.data.classSlug}/${r.data.subjectSlug}/`}>
              <span class="recent-tag">{r.data.classSlug.toUpperCase()}</span>
              <span class="recent-text-group">
                <span class="recent-text">{r.data.title}</span>
                {subline && <span class="recent-subline">{subline}</span>}
              </span>
            </a>
          );
        })}
      </div>
    ) : (
      <p class="empty-note">Nothing uploaded yet. New resources will show up here as they are added.</p>
    )}
  </section>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .hero {
    background: var(--deep, #0F4788);
    color: #fff;
    padding: 34px 18px 28px;
    text-align: center;
  }
  .hero-inner { max-width: 60ch; margin: 0 auto; }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(30px, 8vw, 46px);
    line-height: 1.1;
    text-transform: uppercase;
    margin: 0 0 12px;
    color: #fff;
  }
  .hero h1 span { color: #F5B800; }
  .hero-sub {
    font-size: 16px;
    line-height: 1.5;
    margin: 0 0 20px;
    color: #fff;
  }
  .search-form {
    display: flex;
    gap: 8px;
    max-width: 480px;
    margin: 0 auto 18px;
  }
  .search-form input {
    flex: 1;
    min-width: 0;
    padding: 12px 14px;
    font-size: 15px;
    border: none;
    border-radius: 999px;
    background: #fff;
    color: #111;
  }
  .search-form button {
    padding: 12px 20px;
    border: none;
    border-radius: 999px;
    background: #F5B800;
    color: #0b2a52;
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
  }
  .reassure {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 11px;
    color: #fff;
  }
  .reassure span { display: flex; align-items: center; gap: 6px; }
  .dot { width: 5px; height: 5px; border-radius: 50%; background: #F5B800; }
  .hero-count { margin: 16px 0 0; font-size: 14px; color: #fff; }
  .hero-count strong { color: #F5B800; font-size: 18px; }
  .hero-note { margin: 8px 0 0; font-size: 12px; opacity: 0.85; color: #fff; }

  .level-grid { display: flex; flex-direction: column; gap: 10px; margin-bottom: 8px; }
  .recent-list { display: flex; flex-direction: column; }
  .recent-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
  }
  .recent-row:last-child { border-bottom: none; }
  .recent-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--white);
    background: var(--deep-hover);
    padding: 3px 7px;
    border-radius: 5px;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .recent-text-group { display: flex; flex-direction: column; gap: 2px; }
  .recent-text { font-size: 13px; color: var(--ink); line-height: 1.4; }
  .recent-subline {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-60);
  }
  .empty-note { font-size: 12.5px; color: var(--ink-60); line-height: 1.5; }
</style>
