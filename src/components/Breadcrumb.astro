---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props as Props;
---
<nav class="crumb" aria-label="Breadcrumb">
  {items.map((item, i) => (
    <span>
      {item.href ? <a href={item.href}>{item.label}</a> : <b>{item.label}</b>}
      {i < items.length - 1 && <span class="sep">›</span>}
    </span>
  ))}
</nav>

<style>
  .crumb {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-35);
    padding: 14px 18px 0;
    display: block;
  }
  .crumb a { color: var(--ink-60); }
  .crumb a:hover { color: var(--deep-hover); }
  .crumb b { color: var(--ink); font-weight: 500; }
  .sep { margin: 0 6px; }
</style>
