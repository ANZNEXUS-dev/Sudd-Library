---
interface Props {
  name: string;
  description: string;
  href: string;
  icon: 'primary' | 'secondary' | 'aes';
}
const { name, description, href, icon } = Astro.props as Props;

const iconPaths: Record<Props['icon'], string> = {
  primary: 'M4 19.5V5a2 2 0 012-2h13v16H6a2 2 0 00-2 2z M6 19.5h13',
  secondary: 'M22 10L12 5 2 10l10 5 10-5z M6 12v5c3 2 9 2 12 0v-5',
  aes: 'M12 22s8-4.5 8-11a8 8 0 10-16 0c0 6.5 8 11 8 11z',
};
const toneClass: Record<Props['icon'], string> = {
  primary: 'tone-a',
  secondary: 'tone-b',
  aes: 'tone-c',
};
---
<a class="level-card" href={href}>
  <span class={`level-icon ${toneClass[icon]}`}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d={iconPaths[icon]} stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
  <span class="level-text">
    <span class="level-name">{name}</span>
    <span class="level-sub">{description}</span>
  </span>
  <span class="level-arrow" aria-hidden="true">›</span>
</a>

<style>
  .level-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 15px 16px;
  }
  .level-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .tone-a { background: rgba(15, 71, 136, 0.12); color: var(--deep-hover); }
  .tone-b { background: rgba(242, 196, 17, 0.22); color: var(--gold-deep); }
  .tone-c { background: rgba(20, 133, 64, 0.14); color: var(--green); }
  .level-text { display: flex; flex-direction: column; gap: 2px; }
  .level-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    color: var(--ink);
  }
  .level-sub { font-size: 12.5px; color: var(--ink-60); }
  .level-arrow { margin-left: auto; color: var(--ink-35); font-size: 18px; }
</style>
